#Task 8 Morphological operation
#flower1
# Erosion - shrinks white regions, removes small noise specks
flower1.thresh <- threshold(flower1.g, "15%")
flower1.eroded <- erode_square(flower1.thresh, 3)
plot(flower1.eroded, main = "Eroded")

# Dilation - expands white regions, fills small holes/gaps
flower1.dilated <- dilate_square(flower1.thresh, 3)
plot(flower1.dilated, main = "Dilated")

# Opening (erosion then dilation) - removes small noise while preserving overall shape
flower1.opened <- flower1.thresh %>% erode_square(3) %>% dilate_square(3)
plot(flower1.opened, main = "Opened")

# Closing (dilation then erosion) - fills small holes while preserving overall shape
flower1.closed <- flower1.thresh %>% dilate_square(3) %>% erode_square(3)
plot(flower1.closed, main = "Closed")

# Compare all results side by side
layout(t(1:4))
plot(flower1.thresh,  main = "Original threshold")
plot(flower1.eroded,  main = "Eroded")
plot(flower1.dilated, main = "Dilated")
plot(flower1.opened,  main = "Opened")

