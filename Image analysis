# ============ TASK 1: SPLITTING & CONCATENATING ============

# --- Flower 1 (Colour) ---
# Splitting into RGB channels
flower1.red   <- R(flower1)
flower1.green <- G(flower1)
flower1.blue  <- B(flower1)
layout(t(1:4))
plot(flower1,       main = "Flower1 Original")
plot(flower1.red,   main = "Flower1 Red Channel")
plot(flower1.green, main = "Flower1 Green Channel")
plot(flower1.blue,  main = "Flower1 Blue Channel")

# Concatenating flower1 and flower2 side by side
flower.combined <- imappend(list(flower1, flower2), axis="x")
plot(flower.combined, main = "Flower1 & Flower2 Combined")

# --- Flower 2 (Grey) ---
# Grey images only have one channel so we split by top/bottom
flower2.top    <- imsub(flower2, y <= height(flower2)/2)
flower2.bottom <- imsub(flower2, y >  height(flower2)/2)
layout(t(1:3))
plot(flower2,        main = "Flower2 Original")
plot(flower2.top,    main = "Flower2 Top Half")
plot(flower2.bottom, main = "Flower2 Bottom Half")

# Concatenating top and bottom back together
flower2.combined <- imappend(list(flower2.top, flower2.bottom), axis="y")
plot(flower2.combined, main = "Flower2 Rejoined")

